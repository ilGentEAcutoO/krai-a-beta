{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krai-a-beta",
  // SORNKan Co., Ltd. — pinned so deploys never land in the wrong account.
  "account_id": "a24ce30584273b42333051f1cdec48e2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "beta.krai-a.com/*", "zone_name": "krai-a.com" }],
  // Realtime voice relay: browser -> VoiceCall DO -> Meta (Hibernation API,
  // so idle calls cost no duration). Smart placement keeps the extra hop
  // near the caller (free; latency only).
  "placement": { "mode": "smart" },
  "durable_objects": {
    "bindings": [{ "name": "VOICE_CALL", "class_name": "VoiceCall" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceCall"] }],
  "observability": {
    "enabled": true
  },
  // Public values only. Secrets (META_MODEL_API_KEY) go through
  // `wrangler secret put` — never here, vars would shadow them on deploy.
  "vars": {
    "APP_NAME": "krai-a-beta",
    "APP_URL": "https://beta.krai-a.com"
  }
}
