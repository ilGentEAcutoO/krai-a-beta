{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "krai-a-beta",
  // SORNKan Co., Ltd. — pinned so deploys never land in the wrong account.
  "account_id": "a24ce30584273b42333051f1cdec48e2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "beta.krai-a.com/*", "zone_name": "krai-a.com" }],
  // Realtime voice relay: browser -> VoiceCall DO -> Meta (Hibernation API,
  // so idle calls cost no duration). Smart placement keeps the extra hop
  // near the caller (free; latency only).
  "placement": { "mode": "smart" },
  // Abuse guard (B7, src/abuse.js): BUDGET is one global daily-USD ledger,
  // RATE_LIMIT is sharded one instance per salted IP hash.
  "durable_objects": {
    "bindings": [
      { "name": "VOICE_CALL", "class_name": "VoiceCall" },
      { "name": "BUDGET", "class_name": "Budget" },
      { "name": "RATE_LIMIT", "class_name": "RateLimit" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VoiceCall"] },
    { "tag": "v2", "new_sqlite_classes": ["Budget", "RateLimit"] }
  ],
  "observability": {
    "enabled": true
  },
  // Public values only. Secrets (META_MODEL_API_KEY, SESSION_SECRET,
  // TURNSTILE_SECRET, GEMINI_API_KEY) and the KILL_SWITCH go through `wrangler secret put` —
  // never here, vars would shadow them on deploy. KILL_SWITCH stays a secret
  // so it can be flipped instantly without a deploy.
  "vars": {
    "APP_NAME": "krai-a-beta",
    "APP_URL": "https://beta.krai-a.com",
    // Daily Meta spend cap in USD (UTC day); Budget DO refuses any call
    // whose reserved worst case would cross it. Judging window Nov 5-9.
    // Default in code is 5.
    "DAILY_USD_CAP": "5",
    // Cumulative Meta cap counted from TOTAL_SINCE (UTC day of submission):
    // at $10 every Meta route answers 503 'budget-total' and the demo pauses
    // itself, so the free credit is never exceeded and the card never billed.
    "TOTAL_USD_CAP": "10",
    "TOTAL_SINCE": "2026-11-05",
    // Gemini TTS (voice output only, live trap lines; fixed lines are static
    // files): its own ledger, $1/day and $3 in total since TOTAL_SINCE.
    // The key is the GEMINI_API_KEY secret; without it /api/tts answers
    // 503 'tts-off' and the page uses the browser voice.
    "TTS_DAILY_USD_CAP": "1",
    "TTS_TOTAL_USD_CAP": "3",
    // Turnstile public site key (fill after the widget is created).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFxXTQfgJkgC66A_", // widget krai-a-beta-turnstile-session (managed)
    // Siteverify hostname allowlist (production only; never localhost).
    "TURNSTILE_HOSTNAMES": "beta.krai-a.com"
    // TURNSTILE_OPTIONAL is deliberately absent: without TURNSTILE_SECRET a
    // public deploy refuses to issue sessions. Set TURNSTILE_OPTIONAL="1"
    // only as a conscious, temporary switch (e.g. before the widget exists).
    // Local dev: put TURNSTILE_OPTIONAL=1 (or APP_URL=http://localhost:8787 +
    // TURNSTILE_HOSTNAMES=localhost) in .dev.vars.
  }
}
