# Copy this file to .dev.vars and fill real values (gitignored, local `wrangler dev` only).
# Production secrets: `wrangler secret put <NAME>` — never commit real values.

# ──────────────────────────────────────────
# Meta Model API (pay-as-you-go key)
# get from: https://dev.meta.ai -> API keys
# ──────────────────────────────────────────
# Server-side only. The browser must never see this key.
# Spend alert: set a notification in the Meta console (the API has no hard cap).
META_MODEL_API_KEY=your-meta-model-api-key

# ──────────────────────────────────────────
# Abuse guard (src/abuse.js) — sessions, kill switch, daily budget
# ──────────────────────────────────────────
# HMAC key for the 30-minute session tokens + IP-hash salt. Required: model
# routes answer 503 'misconfigured' without it.
# generate: openssl rand -hex 32
# prod:     npx wrangler secret put SESSION_SECRET
SESSION_SECRET=your-random-64-hex-chars

# Kill switch: "1" or "true" pauses every model route (503 'paused').
# prod (instant, no deploy): npx wrangler secret put KILL_SWITCH  -> 1 / 0
KILL_SWITCH=0

# Daily Meta spend cap in USD, UTC day (prod value lives in wrangler.jsonc vars).
DAILY_USD_CAP=5

# Cumulative Meta cap since TOTAL_SINCE (UTC day, YYYY-MM-DD); at the cap every
# Meta route answers 503 'budget-total' (prod values live in wrangler.jsonc vars).
# Leave TOTAL_SINCE empty locally = no cumulative cap.
TOTAL_USD_CAP=45
TOTAL_SINCE=

# ──────────────────────────────────────────
# Gemini TTS — receptionist voice OUTPUT only (Meta's API has no TTS)
# get from: https://aistudio.google.com/apikey
# ──────────────────────────────────────────
# Speaks live trap lines via POST /api/tts (fixed lines are static files in
# public/audio, made by scripts/tts-pregen.mjs). Empty = /api/tts answers
# 503 'tts-off' and the page falls back to the browser voice.
# prod: npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=your-gemini-api-key
# Own ledger: daily + cumulative USD caps (prod values in wrangler.jsonc vars).
TTS_DAILY_USD_CAP=1
TTS_TOTAL_USD_CAP=3

# ──────────────────────────────────────────
# Cloudflare Turnstile (bot check before a session)
# get from: Cloudflare dashboard -> Turnstile -> widget for beta.krai-a.com
# ──────────────────────────────────────────
# Leave TURNSTILE_SECRET empty locally = "no-turnstile" mode (/api/session
# issues tokens without Siteverify; rate limit + budget still apply).
# prod: npx wrangler secret put TURNSTILE_SECRET
TURNSTILE_SECRET=
# APP_URL is https in wrangler.jsonc, so without a TURNSTILE_SECRET sessions are
# refused unless this conscious switch is on. Local dev: 1. Prod: set only until
# the Turnstile widget exists (npx wrangler secret put TURNSTILE_OPTIONAL).
TURNSTILE_OPTIONAL=1
# Public site key (prod value lives in wrangler.jsonc vars).
TURNSTILE_SITE_KEY=your-turnstile-site-key
# Comma list of frontend hostnames Siteverify must return (local only here;
# production never includes localhost).
TURNSTILE_HOSTNAMES=localhost

# ──────────────────────────────────────────
# Family chat delivery adapters (src/notify, docs/ADAPTERS.md) — OPT-IN
# ──────────────────────────────────────────
# Nothing is sent unless NOTIFY_ENABLED=1 AND a channel's vars are set. The
# public demo leaves all of this empty. Test one channel:
#   npm run notify:test -- --channel telegram|whatsapp|line|all [--dry-run]
NOTIFY_ENABLED=0
# Optional: only these verdicts are sent (empty = all). e.g. SCAM,UNSURE
NOTIFY_VERDICTS=
# Optional: per-channel cap per hour per isolate (default 6).
NOTIFY_MAX_PER_HOUR=6

# Telegram — get from: @BotFather (/newbot) ; chat id from getUpdates
# prod: npx wrangler secret put TELEGRAM_BOT_TOKEN  (and TELEGRAM_CHAT_ID)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=

# WhatsApp Cloud API — get from: developers.facebook.com -> your app -> WhatsApp -> API Setup
# Free-form text only arrives inside the 24 h customer service window; set
# WHATSAPP_TEMPLATE to an APPROVED utility template to reach the family any time.
# prod: npx wrangler secret put WHATSAPP_TOKEN  (and WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_TO)
WHATSAPP_TOKEN=your-whatsapp-system-user-token
WHATSAPP_PHONE_NUMBER_ID=
# Recipient number in international format, e.g. +66812345678
WHATSAPP_TO=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=th
# Optional Graph API version override (default v26.0)
WHATSAPP_GRAPH_VERSION=

# LINE Messaging API (LINE Notify is discontinued) — get from: developers.line.biz
# -> Messaging API channel -> long-lived channel access token
# LINE_TO = userId (U...) or groupId (C...) of a chat that added the bot
# prod: npx wrangler secret put LINE_CHANNEL_ACCESS_TOKEN  (and LINE_TO)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_TO=
